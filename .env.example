# Environment Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection String (Prisma)
DATABASE_URL=postgresql://username:password@localhost:5432/echogpt_db?schema=public

# JWT Authentication Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Redis Cache & Session Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your_redis_password_here

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@example.com
SMTP_PASSWORD=your_smtp_password
EMAIL_SENDER=noreply@example.com

# Initial Database Seed Credentials
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminSecurePassword123!

USER_NAME=Standard User
USER_EMAIL=user@example.com
USER_PASSWORD=UserSecurePassword123!

# AI Provider API Keys (Optional)
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER_ENCRYPTION_KEY=

# bKash Payment Gateway Configuration
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback
# Search Provider & Cache Configuration
SEARCH_API_KEY=
TAVILY_API_KEY=
SEARCH_API_BASE_URL=
SEARCH_CACHE_TTL=600

